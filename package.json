{
  "name": "campus-attendance-pwa",
  "version": "2.0.0",
  "description": "Code-verified campus attendance PWA on Supabase",
  "private": true,
  "scripts": {
    "start": "npx serve .",
    "test:ui": "node tests/ui/tests.js",
    "vitals": "node tests/ui/vitals.js"
  },
  "runtimeDependencies": {
    "@supabase/supabase-js": "2.45.4 (loaded from cdn.jsdelivr.net in index.html, no install needed)"
  },
  "backend": {
    "platform": "Supabase",
    "project_ref": "ovdprijwhvmkiahxjqrx",
    "postgres": "17",
    "auth_provider": "Google",
    "edge_functions": [
      "export-to-sheets (Super Admin)",
      "admin-users (Super Admin)"
    ],
    "required_secrets": [
      "GOOGLE_SERVICE_ACCOUNT_JSON",
      "GOOGLE_SHEET_ID (optional default)"
    ]
  },
  "devDependencies": {
    "supabase": "^3.2.0"
  }
}
